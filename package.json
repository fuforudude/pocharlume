{
  "name": "pocharlume",
  "version": "0.1.0",
  "private": true,
  "description": "Tower defense de chats dans un Moyen Âge sombre, jouable au doigt et à la souris.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "art": "node tools/art/index.ts",
    "lore": "node tools/lore/reporter.ts",
    "sons": "node tools/sons/copier.ts",
    "balance": "node --import ./tools/niveaux/enregistrer.ts tools/balance/index.ts",
    "niveaux": "node --import ./tools/niveaux/enregistrer.ts tools/niveaux/generer.ts",
    "niveaux:bilan": "node --import ./tools/niveaux/enregistrer.ts tools/niveaux/bilan.ts",
    "niveaux:resume": "node --import ./tools/niveaux/enregistrer.ts tools/niveaux/resume.ts",
    "niveaux:apercu": "node --import ./tools/niveaux/enregistrer.ts tools/niveaux/apercu.ts",
    "niveaux:statues": "node --import ./tools/niveaux/enregistrer.ts tools/niveaux/statues.ts",
    "verifier": "npm run lint && tsc --noEmit && npm run test && npm run build",
    "ci:attendre": "node tools/ci/attendre.ts",
    "editeur": "node --import ./tools/niveaux/enregistrer.ts tools/atelier/lancer.ts --config atelier.config.ts",
    "dlc:apercu": "node tools/dlc/apercu.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
